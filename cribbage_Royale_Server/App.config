	<connectionStrings>
		<add name="CribbageEntities" connectionString="metadata=res://*/CribbageModel.csdl|res://*/CribbageModel.ssdl|res://*/CribbageModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=cribbage_royale;persist security info=True;user id=cribbage_app;password=Cr1bb4ge$R0yale;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	</connectionStrings>

	<system.serviceModel>
		<services>
			<service name="CribbageRoyale.Server.Services.StatisticsService">
