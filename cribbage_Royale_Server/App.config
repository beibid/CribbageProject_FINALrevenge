<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings configSource="ConnectionStrings.config" />

	<system.serviceModel>
		<services>
			<service name="CribbageRoyale.Server.Services.StatisticsService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8090/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="Statistics" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IStatistics" />
			</service>

			<service name="CribbageRoyale.Server.Services.PlayerSessionService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8091/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="PlayerSession" binding="netTcpBinding" bindingConfiguration="CribbageSessionBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IPlayerSession" />
			</service>
			<service name="CribbageRoyale.Server.Services.FriendListService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8092/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="FriendList" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IFriendList" />
			</service>
			<service name="CribbageRoyale.Server.Services.FriendRequestsService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8093/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="FriendRequests" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IFriendRequests" />
			</service>
			<service name="CribbageRoyale.Server.Services.FriendChatService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8094/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="FriendChat" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IFriendChat" />
			</service>
			<service name="CribbageRoyale.Server.Services.MatchInvitationService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8095/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="MatchInvitation" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IMatchInvitation" />
			</service>
			<service name="CribbageRoyale.Server.Services.MatchPlayService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8096/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="MatchPlay" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IMatchPlay" />
			</service>
			<service name="CribbageRoyale.Server.Services.PlayerProfileService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8097/CribbageRoyale" />
					</baseAddresses>
				</host>
				<endpoint address="PlayerProfile" binding="netTcpBinding" bindingConfiguration="CribbageBinding" contract="CribbageRoyale.Contracts.ServiceContracts.IPlayerProfile" />
			</service>
		</services>
		
		<bindings>
			<netTcpBinding>
				<binding name="CribbageBinding">
					<security mode="None" />
				</binding>

				<binding name="CribbageSessionBinding" receiveTimeout="10:00:00" sendTimeout="00:00:10">
					<reliableSession enabled="true" inactivityTimeout="00:00:30" />
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>

		<behaviors>
			<serviceBehaviors>
				<behavior>
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Serilog" publicKeyToken="24c2f752a8e58a10" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.4.0.0" newVersion="4.4.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>