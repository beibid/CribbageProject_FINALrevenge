    [player_statistics_view].[account_id] AS [account_id], 
    [player_statistics_view].[username] AS [username], 
    [player_statistics_view].[display_name] AS [display_name], 
    [player_statistics_view].[skill_level] AS [skill_level], 
    [player_statistics_view].[matches_played] AS [matches_played], 
    [player_statistics_view].[wins] AS [wins], 
    [player_statistics_view].[losses] AS [losses], 
    [player_statistics_view].[current_streak] AS [current_streak], 
    [player_statistics_view].[win_percentage] AS [win_percentage]
    FROM [dbo].[player_statistics_view] AS [player_statistics_view]</DefiningQuery>
