            <DefiningQuery>SELECT 
    [active_suspension_view].[account_id] AS [account_id], 
    [active_suspension_view].[reason] AS [reason], 
    [active_suspension_view].[ends_at] AS [ends_at]
    FROM [dbo].[active_suspension_view] AS [active_suspension_view]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="crib_view" EntityType="Self.crib_view" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [crib_view].[round_id] AS [round_id], 
    [crib_view].[owner_participant_id] AS [owner_participant_id], 
    [crib_view].[card_id] AS [card_id], 
    [crib_view].[suit] AS [suit], 
    [crib_view].[rank_value] AS [rank_value]
    FROM [dbo].[crib_view] AS [crib_view]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="friend_view" EntityType="Self.friend_view" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [friend_view].[account_id] AS [account_id], 
    [friend_view].[friend_account_id] AS [friend_account_id], 
    [friend_view].[responded_at] AS [responded_at]
    FROM [dbo].[friend_view] AS [friend_view]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="match_scoreboard_view" EntityType="Self.match_scoreboard_view" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [match_scoreboard_view].[match_id] AS [match_id], 
    [match_scoreboard_view].[match_participant_id] AS [match_participant_id], 
    [match_scoreboard_view].[account_id] AS [account_id], 
    [match_scoreboard_view].[board_position] AS [board_position], 
    [match_scoreboard_view].[credited_points] AS [credited_points]
    FROM [dbo].[match_scoreboard_view] AS [match_scoreboard_view]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="player_statistics_view" EntityType="Self.player_statistics_view" store:Type="Views" store:Schema="dbo">
