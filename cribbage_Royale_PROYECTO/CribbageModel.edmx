            <DefiningQuery>SELECT 
    [vista_amigos].[id_usuario] AS [id_usuario], 
    [vista_amigos].[id_usuario_amigo] AS [id_usuario_amigo], 
    [vista_amigos].[fecha_respuesta] AS [fecha_respuesta]
    FROM [dbo].[vista_amigos] AS [vista_amigos]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="vista_crib" EntityType="Self.vista_crib" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vista_crib].[id_manga] AS [id_manga], 
    [vista_crib].[id_participante_dueno] AS [id_participante_dueno], 
    [vista_crib].[id_carta] AS [id_carta], 
    [vista_crib].[palo] AS [palo], 
    [vista_crib].[valor] AS [valor]
    FROM [dbo].[vista_crib] AS [vista_crib]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="vista_estadisticas_jugador" EntityType="Self.vista_estadisticas_jugador" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vista_estadisticas_jugador].[id_usuario] AS [id_usuario], 
    [vista_estadisticas_jugador].[nombre_usuario] AS [nombre_usuario], 
    [vista_estadisticas_jugador].[nombre_mostrado] AS [nombre_mostrado], 
    [vista_estadisticas_jugador].[nivel_habilidad] AS [nivel_habilidad], 
    [vista_estadisticas_jugador].[partidas_jugadas] AS [partidas_jugadas], 
    [vista_estadisticas_jugador].[victorias] AS [victorias], 
    [vista_estadisticas_jugador].[derrotas] AS [derrotas], 
    [vista_estadisticas_jugador].[racha_actual] AS [racha_actual], 
    [vista_estadisticas_jugador].[porcentaje_victorias] AS [porcentaje_victorias]
    FROM [dbo].[vista_estadisticas_jugador] AS [vista_estadisticas_jugador]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="vista_marcador_partida" EntityType="Self.vista_marcador_partida" store:Type="Views" store:Schema="dbo">
