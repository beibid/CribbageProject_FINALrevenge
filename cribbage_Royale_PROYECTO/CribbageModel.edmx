    [vista_marcador_partida].[id_participante] AS [id_participante], 
    [vista_marcador_partida].[id_usuario] AS [id_usuario], 
    [vista_marcador_partida].[posicion_tablero] AS [posicion_tablero], 
    [vista_marcador_partida].[puntos_acreditados] AS [puntos_acreditados]
    FROM [dbo].[vista_marcador_partida] AS [vista_marcador_partida]</DefiningQuery>
