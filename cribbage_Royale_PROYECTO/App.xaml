<Application x:Class="cribbage_Royale_PROYECTO.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:cribbage_Royale_PROYECTO"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B2118" options:Freeze="True"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#D9B650" options:Freeze="True"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#F06262" options:Freeze="True"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" options:Freeze="True"/>
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#06150F" options:Freeze="True"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#13301F" options:Freeze="True"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#0A1A12" options:Freeze="True"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#7A8C82" options:Freeze="True"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A3AEA8" options:Freeze="True"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#3FA95C" options:Freeze="True"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E03E3E" options:Freeze="True"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#F2DC8A" options:Freeze="True"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#33D9B650" options:Freeze="True"/>
        <SolidColorBrush x:Key="NeutralSoftBrush" Color="#26A3AEA8" options:Freeze="True"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#33F06262" options:Freeze="True"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" options:Freeze="True"/>

        <SolidColorBrush x:Key="CardFaceBrush" Color="#FFFFFF" options:Freeze="True"/>
        <SolidColorBrush x:Key="CardBlackSuitBrush" Color="#101010" options:Freeze="True"/>
        <SolidColorBrush x:Key="CardRedSuitBrush" Color="#D6332F" options:Freeze="True"/>

        <DropShadowEffect x:Key="PrimaryGlowEffect"
                          Color="#D9B650"
                          BlurRadius="28"
                          ShadowDepth="0"
                          Opacity="0.9"
                          options:Freeze="True"/>

        <DropShadowEffect x:Key="DangerGlowEffect"
                          Color="#F06262"
                          BlurRadius="16"
                          ShadowDepth="0"
                          Opacity="0.55"
                          options:Freeze="True"/>

        <DropShadowEffect x:Key="PanelShadowEffect"
                          Color="#000000"
                          BlurRadius="20"
                          ShadowDepth="3"
                          Opacity="0.40"
                          options:Freeze="True"/>

        <sys:Double x:Key="ButtonMinWidth">340</sys:Double>
        <sys:Double x:Key="ButtonHeight">48</sys:Double>
        <sys:Double x:Key="ButtonFontSize">15</sys:Double>
        <sys:Double x:Key="PlayingCardWidth">90</sys:Double>
        <sys:Double x:Key="PlayingCardHeight">130</sys:Double>
        <Thickness x:Key="ButtonPadding">16,0</Thickness>
        <Thickness x:Key="ButtonMargin">0,6</Thickness>
        <Thickness x:Key="PanelPadding">20</Thickness>
        <Thickness x:Key="PlayingCardMargin">0,0,10,0</Thickness>
        <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="FocusRingCornerRadius">11</CornerRadius>
        <CornerRadius x:Key="InputCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="PanelCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="PlayingCardCornerRadius">6</CornerRadius>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidth}"/>
            <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="Margin" Value="{StaticResource ButtonMargin}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="focusRingBorder"
                                    Margin="-3"
                                    CornerRadius="{StaticResource FocusRingCornerRadius}"
                                    BorderBrush="{StaticResource FocusBrush}"
                                    BorderThickness="2"
                                    Opacity="0"/>

                            <Border x:Name="buttonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ButtonCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRingBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource PrimaryGlowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource PrimaryGlowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource DangerGlowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder"
                                Background="Transparent"
                                CornerRadius="{StaticResource InputCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder"
                                        Property="Background"
                                        Value="{StaticResource NeutralSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="closeBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="closeBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource PanelPadding}"/>
            <Setter Property="Effect" Value="{StaticResource PanelShadowEffect}"/>
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="switchTrackBorder"
                                Width="36"
                                Height="20"
                                Background="{StaticResource TrackBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Ellipse x:Name="switchKnobEllipse"
                                     Width="14"
                                     Height="14"
                                     Margin="3,0"
                                     Fill="{StaticResource InputBorderBrush}"
                                     HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="switchTrackBorder"
                                        Property="Background"
                                        Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="switchTrackBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="switchKnobEllipse"
                                        Property="Fill"
                                        Value="{StaticResource BackgroundBrush}"/>
                                <Setter TargetName="switchKnobEllipse"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="switchTrackBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="switchTrackBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="switchTrackBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="switchTrackBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="switchTrackBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder"
                                        Property="Background"
                                        Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="dropDownToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="toggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource InputCornerRadius}">
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{StaticResource InputBorderBrush}"
                                                  Margin="0,0,14,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource PrimaryHoverBrush}"/>
                                                <Setter TargetName="toggleBorder"
                                                        Property="BorderThickness"
                                                        Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="12,0,32,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,0,0"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource InputCornerRadius}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TutorialHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TutorialText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="inputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource InputCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="inputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="inputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="inputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="inputBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="inputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource InputCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="inputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="inputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="inputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="inputBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="tabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TutorialNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="selectionBar"
                                    Grid.Column="0"
                                    Background="{StaticResource GoldBrush}"
                                    Opacity="0"/>

                            <Border x:Name="itemBorder"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Padding="14,12"
                                    BorderBrush="{StaticResource FocusBrush}"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder"
                                        Property="Background"
                                        Value="{StaticResource NeutralSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="selectionBar" Property="Opacity" Value="1"/>
                                <Setter TargetName="itemBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayingCardBack" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource PlayingCardWidth}"/>
            <Setter Property="Height" Value="{StaticResource PlayingCardHeight}"/>
            <Setter Property="Margin" Value="{StaticResource PlayingCardMargin}"/>
            <Setter Property="CornerRadius" Value="{StaticResource PlayingCardCornerRadius}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <DataTemplate x:Key="PlayingCardFaceTemplate">
            <Grid x:Name="cardFaceGrid"
          Margin="6"
          TextElement.Foreground="{StaticResource CardBlackSuitBrush}">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Rank}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Suit}" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="{Binding Suit}"
                   FontSize="34"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRedSuit}" Value="True">
                    <Setter TargetName="cardFaceGrid"
                    Property="TextElement.Foreground"
                    Value="{StaticResource CardRedSuitBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PlayingCardToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="{StaticResource PlayingCardWidth}"/>
            <Setter Property="Height" Value="{StaticResource PlayingCardHeight}"/>
            <Setter Property="Margin" Value="{StaticResource PlayingCardMargin}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="cardBorder"
                        Background="{StaticResource CardFaceBrush}"
                        CornerRadius="{StaticResource PlayingCardCornerRadius}"
                        BorderBrush="Transparent"
                        BorderThickness="3">
                            <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource PlayingCardFaceTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder"
                                Property="BorderBrush"
                                Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="cardBorder"
                                Property="BorderBrush"
                                Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder"
                                Property="BorderBrush"
                                Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="cardBorder"
                                Property="Effect"
                                Value="{StaticResource PrimaryGlowEffect}"/>
                                <Setter TargetName="cardBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="cardBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoardHoleEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MessagePanelBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource InputCornerRadius}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="MessagePanelError" TargetType="Border" BasedOn="{StaticResource MessagePanelBase}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
        </Style>

        <Style x:Key="MessagePanelWarning" TargetType="Border" BasedOn="{StaticResource MessagePanelBase}">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        </Style>

        <Style x:Key="MessagePanelInformation" TargetType="Border" BasedOn="{StaticResource MessagePanelBase}">
            <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        </Style>

    </Application.Resources>
</Application>