<UserControl x:Class="cribbage_Royale_PROYECTO.Views.Messages.MessagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
             mc:Ignorable="d"
             d:DesignWidth="600">
    <Border x:Name="messageBorder"
            Style="{StaticResource MessagePanelInformation}"
            Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="severityLabelTextBlock"
                       FontSize="12" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{Binding BorderBrush, ElementName=messageBorder}"/>

            <TextBlock x:Name="messageTextBlock" Grid.Column="1"
                       Foreground="{StaticResource TextBrush}" FontSize="13"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>

            <Button x:Name="dismissButton" Grid.Column="2"
                    Style="{StaticResource CloseButton}"
                    Content="{x:Static lang:Lang.MessagePanel_DismissButton}"
                    Width="Auto" Padding="10,0" FontSize="12"
                    Click="DismissButton_Click"/>
        </Grid>
    </Border>
</UserControl>