<Page x:Class="cribbage_Royale_PROYECTO.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="ProfilePage">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="{x:Static lang:Lang.Profile_PageTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="closeButton" Content="{x:Static lang:Lang.Common_CloseButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Width="110" Height="32" FontSize="12"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="20" Margin="0,0,10,0" VerticalAlignment="Top">
            <StackPanel>
                <Ellipse Width="70" Height="70" Fill="{StaticResource GoldBrush}"
                         HorizontalAlignment="Left" Margin="0,0,0,14"/>

                <TextBlock x:Name="usernameTextBlock" Foreground="{StaticResource TextBrush}"
                           FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="emailTextBlock" Foreground="{StaticResource TextBrush}"
                           FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="memberSinceTextBlock" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" Margin="0,0,0,20"/>

                <Button x:Name="editProfileButton" Content="{x:Static lang:Lang.Profile_EditProfileButton}"
                        Style="{StaticResource SecondaryButton}" MinWidth="0" Height="34" FontSize="12"
                        Click="EditProfileButton_Click"/>
                <Button x:Name="changePasswordButton" Content="{x:Static lang:Lang.Profile_ChangePasswordButton}"
                        Style="{StaticResource SecondaryButton}" MinWidth="0" Height="34" FontSize="12"
                        Click="ChangePasswordButton_Click"/>
                <Button x:Name="matchHistoryButton" Content="{x:Static lang:Lang.Profile_MatchHistoryButton}"
                        Style="{StaticResource SecondaryButton}" MinWidth="0" Height="34" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="20" Margin="10,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{x:Static lang:Lang.Profile_StatisticsTitle}"
                           Foreground="{StaticResource GoldBrush}"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{x:Static lang:Lang.Profile_MatchesPlayedLabel}"
                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="matchesPlayedTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{x:Static lang:Lang.Profile_MatchesWonLabel}"
                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="matchesWonTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{x:Static lang:Lang.Profile_MatchesLostLabel}"
                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="matchesLostTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{x:Static lang:Lang.Profile_WinRateLabel}"
                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="winRateTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid>
                    <TextBlock Text="{x:Static lang:Lang.Profile_BestHandLabel}"
                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="bestHandTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>