<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.MatchInformationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
    <StackPanel Margin="16">
        <TextBlock x:Name="titleTextBlock" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <messages:MessagePanel x:Name="messagePanel" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="opponentLabel" Grid.Row="0" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="opponentValue" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="skillLabel" Grid.Row="1" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="skillValue" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="scoreLabel" Grid.Row="2" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="scoreValue" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="handLabel" Grid.Row="3" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="handValue" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="dealerLabel" Grid.Row="4" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="dealerValue" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="cutCardLabel" Grid.Row="5" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="cutCardValue" Grid.Row="5" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="countLabel" Grid.Row="6" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="countValue" Grid.Row="6" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="opponentCardsLabel" Grid.Row="7" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="opponentCardsValue" Grid.Row="7" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="turnTimeLabel" Grid.Row="8" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="turnTimeValue" Grid.Row="8" Grid.Column="1" Margin="0,2"/>
            <TextBlock x:Name="opponentStatusLabel" Grid.Row="9" Margin="0,2,12,2" FontWeight="Bold"/>
            <TextBlock x:Name="opponentStatusValue" Grid.Row="9" Grid.Column="1" Margin="0,2"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="reportPlayerButton" Margin="0,0,8,0" Padding="12,4" Click="ReportPlayerButton_Click"/>
            <Button x:Name="closeButton" Padding="12,4" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>