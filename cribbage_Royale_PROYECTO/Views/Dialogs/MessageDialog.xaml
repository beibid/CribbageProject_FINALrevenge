<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="DialogBorder"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5"
            CornerRadius="8" Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="20" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <TextBlock x:Name="MessageText"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,12,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Margin="6,0" Click="AcceptButton_Click"/>
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                        MinWidth="120" Margin="6,0" Visibility="Collapsed"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>