<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.ChangePasswordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static lang:Lang.ChangePassword_WindowTitle}">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5"
            CornerRadius="8" Padding="28,24">
        <StackPanel>
            <TextBlock Text="{x:Static lang:Lang.ChangePassword_WindowTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <TextBlock Text="{x:Static lang:Lang.ChangePassword_CurrentPasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="currentPasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <TextBlock Text="{x:Static lang:Lang.ChangePassword_NewPasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="newPasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <TextBlock Text="{x:Static lang:Lang.ChangePassword_ConfirmNewPasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="confirmPasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <TextBlock Text="{x:Static lang:Lang.ChangePassword_RulesText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Button x:Name="confirmButton" Content="{x:Static lang:Lang.ChangePassword_ConfirmButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,0,6"
                    Click="ConfirmButton_Click"/>

            <Button x:Name="cancelButton" Content="{x:Static lang:Lang.Common_CancelButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Border>
</Window>