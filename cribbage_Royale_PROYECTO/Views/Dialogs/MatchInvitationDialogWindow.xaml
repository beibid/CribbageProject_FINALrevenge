<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.MatchInvitationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource GoldBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="12">
        <StackPanel Margin="16">
            <TextBlock x:Name="titleTextBlock"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <messages:MessagePanel x:Name="messagePanel" Margin="0,0,0,8"/>
            <TextBlock x:Name="invitationMessageTextBlock"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="acceptButton"
                        Style="{StaticResource SecondaryButton}" MinWidth="0"
                        Width="120" Height="32" FontSize="12" Margin="0,0,8,0"
                        Click="AcceptButton_Click"/>
                <Button x:Name="rejectButton"
                        Style="{StaticResource DangerOutlineButton}"
                        Width="120" Height="32" FontSize="12"
                        Click="RejectButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>