<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.MatchInvitationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <StackPanel Margin="16">
        <TextBlock x:Name="titleTextBlock" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <messages:MessagePanel x:Name="messagePanel" Margin="0,0,0,8"/>
        <TextBlock x:Name="invitationMessageTextBlock" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="goToMatchButton" Margin="0,0,8,0" Padding="12,4" Visibility="Collapsed"
                    Click="GoToMatchButton_Click"/>
            <Button x:Name="acceptButton" Margin="0,0,8,0" Padding="12,4" Click="AcceptButton_Click"/>
            <Button x:Name="rejectButton" Padding="12,4" IsCancel="True" Click="RejectButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>