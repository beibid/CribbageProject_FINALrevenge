<Window x:Class="cribbage_Royale_PROYECTO.Views.Dialogs.SuspendAccountDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
        xmlns:local="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
        Title="{x:Static lang:Lang.SuspendAccount_Title}"
        Width="480"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <StackPanel Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{x:Static lang:Lang.SuspendAccount_Title}"
                       FontSize="34"
                       Foreground="{StaticResource GoldBrush}" />
            <TextBlock x:Name="usernameSubtitleTextBlock"
                       FontSize="14"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}" />
            <local:MessagePanel x:Name="messagePanel"
                                 Margin="0,16,0,0" />
            <TextBlock Text="{x:Static lang:Lang.SuspendAccount_ReasonLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,16,0,0" />
            <TextBox x:Name="reasonTextBox"
                     Style="{StaticResource FormTextBox}"
                     MinHeight="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     TextChanged="ReasonTextBox_TextChanged" />
            <TextBlock Text="{x:Static lang:Lang.SuspendAccount_DurationLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,16,0,0" />
            <ComboBox x:Name="durationComboBox"
                      Style="{StaticResource DarkComboBox}"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="DurationComboBox_SelectionChanged" />
            <Button x:Name="applyButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static lang:Lang.SuspendAccount_ApplyButton}"
                    IsEnabled="False"
                    Click="ApplyButton_Click" />
            <Button x:Name="cancelButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.Common_CancelButton}"
                    Click="CancelButton_Click" />
            <Button x:Name="modifyDurationButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Content="{x:Static lang:Lang.SuspendAccount_ModifyDurationButton}"
                    Visibility="Collapsed"
                    Click="ModifyDurationButton_Click" />
            <Button x:Name="reactivateButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource DangerOutlineButton}"
                    Content="{x:Static lang:Lang.SuspendAccount_ReactivateButton}"
                    Visibility="Collapsed"
                    Click="ReactivateButton_Click" />
        </StackPanel>
    </Grid>
</Window>