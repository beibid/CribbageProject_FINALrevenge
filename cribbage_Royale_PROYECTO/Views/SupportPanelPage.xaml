<Page x:Class="cribbage_Royale_PROYECTO.Views.SupportPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      Title="{x:Static lang:Lang.SupportPanel_Title}"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{x:Static lang:Lang.SupportPanel_Title}"
                   FontSize="34"
                   Foreground="{StaticResource GoldBrush}" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static lang:Lang.SupportPanel_PendingReportsHeader}"
                           FontSize="18"
                           Foreground="{StaticResource TextBrush}" />
                <DataGrid x:Name="pendingReportsDataGrid"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_ReportedColumnHeader}"
                                             Binding="{Binding ReportedUsername}" />
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_ReporterColumnHeader}"
                                             Binding="{Binding ReporterUsername}" />
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_ReasonColumnHeader}"
                                             Binding="{Binding Reason}" />
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_DateColumnHeader}"
                                             Binding="{Binding SubmittedDate}" />
                        <DataGridTemplateColumn Header="{x:Static lang:Lang.SupportPanel_ReviewColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{x:Static lang:Lang.SupportPanel_ReviewButton}"
                                            Click="ReviewReportButton_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static lang:Lang.SupportPanel_SuspendedAccountsHeader}"
                           FontSize="18"
                           Foreground="{StaticResource TextBrush}" />
                <DataGrid x:Name="suspendedAccountsDataGrid"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_UsernameColumnHeader}"
                                             Binding="{Binding Username}" />
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_ReasonColumnHeader}"
                                             Binding="{Binding SuspensionReason}" />
                        <DataGridTextColumn Header="{x:Static lang:Lang.SupportPanel_SuspendedUntilColumnHeader}"
                                             Binding="{Binding SuspensionEndDate}" />
                        <DataGridTemplateColumn Header="{x:Static lang:Lang.SupportPanel_ReactivateColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DangerOutlineButton}"
                                            Content="{x:Static lang:Lang.SuspendAccount_ReactivateButton}"
                                            Click="ReactivateAccountButton_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>