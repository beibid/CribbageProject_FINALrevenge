<Page x:Class="cribbage_Royale_PROYECTO.Views.StartMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:cribbage_Royale_PROYECTO.Views"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="StartMenuPage">

    <Grid Background="{StaticResource BackgroundBrush}">


        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--Titulo-->
            <TextBlock Text="{x:Static lang:Lang.StartMenu_Title}"
               Foreground="{StaticResource GoldBrush}"
               FontFamily="Georgia" FontSize="64"
               HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!--Imagenes de las cartas-->
            <Image Source="/Cards/ImagesCards/card-fan.png"
           Height="130" Margin="0,0,0,48"
           RenderOptions.BitmapScalingMode="HighQuality"/>

            <!--Los botones-->
            <Button x:Name="PlayButton" Content="{x:Static lang:Lang.StartMenu_PlayButton}"
            Style="{StaticResource SecondaryButton}" Click="PlayButton_Click"/>
            <Button x:Name="GuestButton" Content="{x:Static lang:Lang.StartMenu_GuestButton}"
            Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="TutorialButton" Content="{x:Static lang:Lang.StartMenu_TutorialButton}"
            Style="{StaticResource SecondaryButton}" Click="TutorialButton_Click"/>
            <Button x:Name="SettingsButton" Content="{x:Static lang:Lang.StartMenu_SettingsButton}"
            Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click"/>
        </StackPanel>

        <!--Version del juego -->
        <TextBlock Text="{x:Static lang:Lang.StartMenu_Version}"
                   Foreground="{StaticResource TextBrush}" Opacity="0.5"
                   FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,20"/>
    </Grid>
</Page>