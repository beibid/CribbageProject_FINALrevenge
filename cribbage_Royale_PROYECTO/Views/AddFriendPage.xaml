<Page x:Class="cribbage_Royale_PROYECTO.Views.AddFriendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="AddFriendPage">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <TextBlock Text="{x:Static lang:Lang.AddFriend_PageTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="closeButton" Content="{x:Static lang:Lang.Common_CloseButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Width="110" Height="32" FontSize="12"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="searchTextBox" Style="{StaticResource FormTextBox}"
                     Margin="0,0,10,0" MaxLength="16"/>
            <Button x:Name="searchButton" Grid.Column="1"
                    Content="{x:Static lang:Lang.Common_SearchButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Width="120" Height="34" FontSize="12"
                    Click="SearchButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <TextBlock x:Name="noResultsTextBlock"
                           Text="{x:Static lang:Lang.AddFriend_NoResultsMessage}"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <ListBox x:Name="resultsListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8" Width="1000">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding UserName}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding RelationshipText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button Content="{x:Static lang:Lang.AddFriend_SendRequestButton}"
                                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                                            Width="200" Height="28" FontSize="11" Margin="0,0,8,0"
                                            Visibility="{Binding SendRequestVisibility}"
                                            Click="SendRequestButton_Click"/>
                                    <Button Content="{x:Static lang:Lang.AddFriend_ViewProfileButton}"
                                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                                            Width="140" Height="28" FontSize="11"
                                            Click="ViewProfileButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>