<Page x:Class="cribbage_Royale_PROYECTO.Views.ChangeEmailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.ChangeEmail_Title}"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <StackPanel Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.ChangeEmail_Title}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="currentEmailTextBlock"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20" />

            <messages:MessagePanel x:Name="changeEmailMessagePanel"
                                   Margin="0,0,0,12" />

            <TextBlock Text="{x:Static lang:Lang.ChangeEmail_NewEmailLabel}"
                       Style="{StaticResource FormLabel}" />

            <TextBox x:Name="newEmailTextBox"
                     Style="{StaticResource FormTextBox}"
                     MaxLength="254" />

            <TextBlock Text="{x:Static lang:Lang.ChangeEmail_ConfirmEmailLabel}"
                       Style="{StaticResource FormLabel}" />

            <TextBox x:Name="confirmEmailTextBox"
                     Style="{StaticResource FormTextBox}"
                     MaxLength="254" />

            <TextBlock Text="{x:Static lang:Lang.ChangeEmail_PasswordLabel}"
                       Style="{StaticResource FormLabel}" />

            <PasswordBox x:Name="passwordBox"
                         Style="{StaticResource FormPasswordBox}"
                         MaxLength="64" />

            <Button x:Name="continueButton"
                    Content="{x:Static lang:Lang.ChangeEmail_ContinueButton}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,24,0,0"
                    Click="ContinueButton_Click" />

            <Button x:Name="cancelButton"
                    Content="{x:Static lang:Lang.ChangeEmail_CancelButton}"
                    Style="{StaticResource NeutralButton}"
                    Margin="0,10,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>