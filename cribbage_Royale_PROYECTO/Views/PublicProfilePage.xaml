<Page x:Class="cribbage_Royale_PROYECTO.Views.PublicProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.PublicProfile_Title}"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel Width="430"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="displayNameTextBlock"
                       FontSize="34"
                       Foreground="{StaticResource GoldBrush}" />
            <TextBlock x:Name="usernameTextBlock"
                       FontSize="14"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <messages:MessagePanel x:Name="messagePanel"
                                    Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="skillLevelTextBlock"
                           Margin="0,0,24,0"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="matchesPlayedTextBlock"
                           Margin="0,0,24,0"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="winPercentageTextBlock"
                           Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <TextBlock x:Name="registrationDateTextBlock"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}" />
            <Button x:Name="addFriendButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static lang:Lang.PublicProfile_AddFriendButton}"
                    Visibility="Collapsed"
                    Click="AddFriendButton_Click" />
            <Button x:Name="cancelRequestButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.PublicProfile_CancelRequestButton}"
                    Visibility="Collapsed"
                    Click="CancelRequestButton_Click" />
            <Button x:Name="acceptRequestButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static lang:Lang.PublicProfile_AcceptRequestButton}"
                    Visibility="Collapsed"
                    Click="AcceptRequestButton_Click" />
            <Button x:Name="rejectRequestButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.PublicProfile_RejectRequestButton}"
                    Visibility="Collapsed"
                    Click="RejectRequestButton_Click" />
            <Button x:Name="removeFriendButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource DangerOutlineButton}"
                    Content="{x:Static lang:Lang.PublicProfile_RemoveFriendButton}"
                    Visibility="Collapsed"
                    Click="RemoveFriendButton_Click" />
            <Button x:Name="unblockButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource DangerOutlineButton}"
                    Content="{x:Static lang:Lang.BlockedPlayers_UnblockButton}"
                    Visibility="Collapsed"
                    Click="UnblockButton_Click" />
            <Button x:Name="blockButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource DangerOutlineButton}"
                    Content="{x:Static lang:Lang.PublicProfile_BlockButton}"
                    Click="BlockButton_Click" />
            <Button x:Name="reportButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Content="{x:Static lang:Lang.PublicProfile_ReportButton}"
                    Click="ReportButton_Click" />
            <Button x:Name="closeButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.Common_CloseButton}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Page>