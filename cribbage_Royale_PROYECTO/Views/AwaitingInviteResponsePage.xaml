<Page x:Class="cribbage_Royale_PROYECTO.Views.AwaitingInviteResponsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="16">
        <TextBlock x:Name="titleTextBlock" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"
                   HorizontalAlignment="Center"/>
        <messages:MessagePanel x:Name="messagePanel" Margin="0,0,0,8"/>
        <TextBlock x:Name="waitingTextBlock" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,16"
                   HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="inviteAgainButton" Margin="0,0,8,0" Padding="16,6" Visibility="Collapsed"
                    Click="InviteAgainButton_Click"/>
            <Button x:Name="cancelInvitationButton" Margin="0,0,8,0" Padding="16,6"
                    Click="CancelInvitationButton_Click"/>
            <Button x:Name="backButton" Padding="16,6" Click="BackButton_Click"/>
        </StackPanel>
    </StackPanel>
</Page>