<Page x:Class="cribbage_Royale_PROYECTO.Views.AwaitingVerificationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="AwaitingVerificationPage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="430"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.AwaitingVerification_Title}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="34" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock x:Name="noticeTextBlock"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,14,0,0"/>

            <messages:MessagePanel x:Name="verificationMessagePanel" Margin="0,20,0,0"/>

            <Button x:Name="alreadyVerifiedButton"
                    Content="{x:Static lang:Lang.AwaitingVerification_VerifiedButton}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="0" HorizontalAlignment="Stretch"
                    Margin="0,28,0,6"
                    Click="AlreadyVerifiedButton_Click"/>

            <Button x:Name="resendButton"
                    Content="{x:Static lang:Lang.AwaitingVerification_ResendButton}"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="0" HorizontalAlignment="Stretch"/>

            <Button x:Name="closeButton"
                    Content="{x:Static lang:Lang.AwaitingVerification_CloseButton}"
                    Style="{StaticResource NeutralButton}"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Page>