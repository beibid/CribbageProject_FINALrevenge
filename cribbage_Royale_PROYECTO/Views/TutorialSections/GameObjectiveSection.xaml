<UserControl x:Class="cribbage_Royale_PROYECTO.Views.TutorialSections.GameObjectiveSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <StackPanel>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_ObjectiveTab}"
                   Style="{StaticResource TutorialHeading}"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_Paragraph1}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_Paragraph2}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_Paragraph3}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_CardValues}"
                   Style="{StaticResource TutorialText}" FontWeight="Bold"/>

        <!-- Example cards -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Margin="0,0,14,0">
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="A ♠" Foreground="Black" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_OnePoint}"
                           Style="{StaticResource TutorialText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,14,0">
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="J ♥" Foreground="Red" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_TenPoints}"
                           Style="{StaticResource TutorialText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,14,0">
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="Q ♣" Foreground="Black" FontSize="16" FontWeight="Bold"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_TenPoints}"
                           Style="{StaticResource TutorialText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel>
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="K ♦" Foreground="Red" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static lang:Lang.Tutorial_Objective_TenPoints}"
                           Style="{StaticResource TutorialText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>