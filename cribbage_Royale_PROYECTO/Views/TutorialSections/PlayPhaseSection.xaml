<UserControl x:Class="cribbage_Royale_PROYECTO.Views.TutorialSections.PlayPhaseSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <StackPanel>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhaseTab}"
                   Style="{StaticResource TutorialHeading}"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_Paragraph1}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_Paragraph2}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_Paragraph3}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_Paragraph4}"
                   Style="{StaticResource TutorialText}"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_ExampleLabel}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource GoldBrush}"
                   FontSize="12" FontWeight="Bold" Margin="0,14,0,6"/>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
            <StackPanel>
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="7 ♠" Foreground="Black" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="firstCountTextBlock"
                           Foreground="{StaticResource TextBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Text="+" Foreground="{StaticResource GoldBrush}" FontSize="22"
                       FontWeight="Bold" VerticalAlignment="Top" Margin="14,28,14,0"/>

            <StackPanel>
                <Border Background="White" Width="60" Height="85" CornerRadius="4"
                        BorderBrush="{StaticResource GoldBrush}" BorderThickness="3">
                    <TextBlock Text="8 ♥" Foreground="Red" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="secondCountTextBlock"
                           Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Background="{StaticResource GoldBrush}" CornerRadius="12"
                    Padding="12,6" VerticalAlignment="Top" Margin="20,26,0,0">
                <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_FifteenBadge}"
                           Foreground="{StaticResource BackgroundBrush}"
                           FontSize="12" FontWeight="Bold"/>
            </Border>

            <TextBlock Text="{x:Static lang:Lang.Tutorial_PlayPhase_Continues}"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                       VerticalAlignment="Top" Margin="14,32,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>