<UserControl x:Class="cribbage_Royale_PROYECTO.Views.TutorialSections.HandCountingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <StackPanel>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCountingTab}"
                   Style="{StaticResource TutorialHeading}"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Paragraph1}"
                   Style="{StaticResource TutorialText}"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_CombinationsTitle}"
                   Style="{StaticResource TutorialText}" FontWeight="Bold"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Fifteen}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,6"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Pairs}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,6"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Runs}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,6"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Flush}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,6"/>
        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_Nobs}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,6"/>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_ExampleTitle}"
                   Style="{StaticResource TutorialText}"
                   Foreground="{StaticResource GoldBrush}"
                   FontWeight="Bold" Margin="0,14,0,8"/>

        <StackPanel Orientation="Horizontal">
            <Border Background="White" Width="60" Height="85" CornerRadius="4" Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="5 ♠" Foreground="Black" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Background="White" Width="60" Height="85" CornerRadius="4" Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="5 ♥" Foreground="Red" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Background="White" Width="60" Height="85" CornerRadius="4" Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="J ♠" Foreground="Black" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Background="White" Width="60" Height="85" CornerRadius="4" Margin="0,0,40,0"
                    VerticalAlignment="Top">
                <TextBlock Text="10 ♦" Foreground="Red" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel>
                <Border Background="White" Width="60" Height="85" CornerRadius="4">
                    <TextBlock Text="5 ♣" Foreground="Black" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static lang:Lang.Tutorial_HandCounting_CutCard}"
                           Style="{StaticResource TutorialText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <Button x:Name="practiceCountingButton"
                Content="{x:Static lang:Lang.Tutorial_HandCounting_PracticeButton}"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Height="40" Padding="24,0" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>