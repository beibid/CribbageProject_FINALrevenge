<Page x:Class="cribbage_Royale_PROYECTO.Views.Lobby"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{x:Static lang:Lang.Lobby_Title}">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="44" Height="44" Fill="{StaticResource GoldBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="playerNameTextBlock" Foreground="{StaticResource TextBrush}"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="playerLevelTextBlock" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="settingsButton" Content="{x:Static lang:Lang.Lobby_SettingsButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Width="110" Height="32" FontSize="12"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="SettingsButton_Click"/>
        </Grid>

        <Border x:Name="invitationBorder" Grid.Row="1" Margin="0,16,0,0"
                Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16,10"
                Visibility="Collapsed">
            <Grid>
                <TextBlock Text="{x:Static lang:Lang.Lobby_PendingInvitation}"
                           Foreground="{StaticResource TextBrush}" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button x:Name="viewInvitationButton" Content="{x:Static lang:Lang.Lobby_ViewButton}"
                        Style="{StaticResource SecondaryButton}" MinWidth="0"
                        Width="80" Height="28" FontSize="11"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,16" Background="{StaticResource PanelBrush}"
                CornerRadius="8" Padding="40">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource CardFaceBrush}" Width="80" Height="112" CornerRadius="6">
                    <TextBlock Text="5 ♦" Foreground="{StaticResource CardRedSuitBrush}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static lang:Lang.Lobby_Title}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_Subtitle}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,6,0,24"/>
                    <Button x:Name="playButton" Content="{x:Static lang:Lang.Lobby_PlayButton}"
                               Style="{StaticResource PrimaryButton}" MinWidth="0" Width="200"
                               Click="PlayButton_Click"/>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource CardFaceBrush}" Width="80" Height="112" CornerRadius="6">
                    <TextBlock Text="5 ♣" Foreground="{StaticResource CardBlackSuitBrush}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="18" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_ProfileCardTitle}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_ProfileCardText}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="46"/>
                    <Button x:Name="profileButton" Content="{x:Static lang:Lang.Lobby_ProfileCardButton}"
                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                            Height="32" FontSize="11" Margin="0,10,0,0"
                            Click="ProfileButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="18" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_SocialCardTitle}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_SocialCardText}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="46"/>
                    <Button x:Name="friendsButton" Content="{x:Static lang:Lang.Lobby_SocialCardButton}"
                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                            Height="32" FontSize="11" Margin="0,10,0,0"
                            Click="FriendsButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="18" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_ScoreboardCardTitle}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_ScoreboardCardText}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="46"/>
                    <Button x:Name="scoreboardButton"
                            Content="{x:Static lang:Lang.Lobby_ScoreboardCardButton}"
                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                            Height="32" FontSize="11" Margin="0,10,0,0"
                            Click="ScoreboardButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="18" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_LearnCardTitle}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static lang:Lang.Lobby_LearnCardText}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="46"/>
                    <Button x:Name="tutorialButton" Content="{x:Static lang:Lang.Lobby_LearnCardButton}"
                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                            Height="32" FontSize="11" Margin="0,10,0,0"
                            Click="TutorialButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>