<Page x:Class="cribbage_Royale_PROYECTO.Views.BlockedPlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.BlockedPlayers_Title}"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel Width="600"
                    HorizontalAlignment="Center">
            <TextBlock Text="{x:Static lang:Lang.BlockedPlayers_Title}"
                       FontSize="34"
                       Foreground="{StaticResource GoldBrush}" />
            <messages:MessagePanel x:Name="messagePanel"
                                    Margin="0,16,0,0" />
            <DataGrid x:Name="blockedPlayersDataGrid"
                      Margin="0,16,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static lang:Lang.BlockedPlayers_DisplayNameColumnHeader}"
                                         Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="{x:Static lang:Lang.BlockedPlayers_UsernameColumnHeader}"
                                         Binding="{Binding Username}" />
                    <DataGridTextColumn Header="{x:Static lang:Lang.BlockedPlayers_DateColumnHeader}"
                                         Binding="{Binding BlockDate}" />
                    <DataGridTemplateColumn Header="{x:Static lang:Lang.BlockedPlayers_UnblockColumnHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DangerOutlineButton}"
                                        Content="{x:Static lang:Lang.BlockedPlayers_UnblockButton}"
                                        Click="UnblockButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="closeButton"
                    Margin="0,16,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.Common_CloseButton}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Page>