<Page x:Class="cribbage_Royale_PROYECTO.Views.DeleteAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.DeleteAccount_Title}"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <StackPanel Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.DeleteAccount_Title}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <Border Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,18">
                <TextBlock Text="{x:Static lang:Lang.DeleteAccount_WarningMessage}"
                           Foreground="{StaticResource CoralBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <messages:MessagePanel x:Name="deleteAccountMessagePanel"
                                   Margin="0,0,0,12" />

            <TextBlock Text="{x:Static lang:Lang.DeleteAccount_PasswordLabel}"
                       Style="{StaticResource FormLabel}" />

            <PasswordBox x:Name="passwordBox"
                         Style="{StaticResource FormPasswordBox}"
                         MaxLength="64" />

            <TextBlock x:Name="confirmationLabelTextBlock"
                       Style="{StaticResource FormLabel}" />

            <TextBox x:Name="confirmationTextBox"
                     Style="{StaticResource FormTextBox}"
                     MaxLength="20" />

            <Button x:Name="deleteAccountButton"
                    Content="{x:Static lang:Lang.DeleteAccount_DeleteButton}"
                    Style="{StaticResource DangerOutlineButton}"
                    Margin="0,24,0,0"
                    Click="DeleteAccountButton_Click" />

            <Button x:Name="cancelButton"
                    Content="{x:Static lang:Lang.DeleteAccount_CancelButton}"
                    Style="{StaticResource NeutralButton}"
                    Margin="0,10,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>