<Page x:Class="cribbage_Royale_PROYECTO.Views.VerifyAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="VerifyAccountPage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="430"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.VerifyAccount_Title}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="34" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock x:Name="subtitleTextBlock"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,14,0,0"/>

            <messages:MessagePanel x:Name="verificationMessagePanel" Margin="0,20,0,0"/>

            <TextBlock Text="{x:Static lang:Lang.VerifyAccount_CodeLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,24,0,4"/>

            <TextBox x:Name="verificationCodeTextBox"
                     Style="{StaticResource FormTextBox}"/>

            <Button x:Name="verifyButton"
                    Content="{x:Static lang:Lang.VerifyAccount_VerifyButton}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="0" HorizontalAlignment="Stretch"
                    Margin="0,10,0,6"
                    Click="VerifyButton_Click"/>

            <Button x:Name="resendButton"
                    Content="{x:Static lang:Lang.VerifyAccount_ResendButton}"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="0" HorizontalAlignment="Stretch"/>

            <Button x:Name="cancelButton"
                    Content="{x:Static lang:Lang.VerifyAccount_CancelButton}"
                    Style="{StaticResource NeutralButton}"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>