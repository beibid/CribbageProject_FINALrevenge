<Page x:Class="cribbage_Royale_PROYECTO.Views.EditProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="EditProfilePage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.EditProfile_PageTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Ellipse x:Name="avatarEllipse" Width="90" Height="90"
                     Fill="{StaticResource PanelBrush}"
                     Stroke="{StaticResource GoldBrush}" StrokeThickness="2"
                     HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button x:Name="changePictureButton" Content="{x:Static lang:Lang.Profile_ChangePictureButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,0,20"
                    Click="ChangePictureButton_Click"/>

            <TextBlock Text="{x:Static lang:Lang.Common_UsernameLabel}"
                       Style="{StaticResource FormLabel}"/>
            <TextBlock x:Name="usernameTextBlock"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" Margin="0,0,0,14"/>

            <TextBlock Text="{x:Static lang:Lang.EditProfile_DisplayNameLabel}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="displayNameTextBox" Style="{StaticResource FormTextBox}" MaxLength="20"/>

            <Button x:Name="saveChangesButton" Content="{x:Static lang:Lang.EditProfile_SaveChangesButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,18,0,6"
                    Click="SaveChangesButton_Click"/>

            <Button x:Name="cancelButton" Content="{x:Static lang:Lang.Common_CancelButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>