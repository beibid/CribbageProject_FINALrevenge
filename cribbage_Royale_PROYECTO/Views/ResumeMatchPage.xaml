<Page x:Class="cribbage_Royale_PROYECTO.Views.ResumeMatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Loaded="Page_Loaded">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="16">
        <TextBlock x:Name="titleTextBlock" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"
                   HorizontalAlignment="Center"/>
        <messages:MessagePanel x:Name="messagePanel" Margin="0,0,0,8"/>
        <TextBlock x:Name="matchMessageTextBlock" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="resumeButton" Margin="0,0,8,0" Padding="16,6" Click="ResumeButton_Click"/>
            <Button x:Name="abandonButton" Margin="0,0,8,0" Padding="16,6" Click="AbandonButton_Click"/>
            <Button x:Name="retryButton" Padding="16,6" Visibility="Collapsed" Click="RetryButton_Click"/>
        </StackPanel>
    </StackPanel>
</Page>