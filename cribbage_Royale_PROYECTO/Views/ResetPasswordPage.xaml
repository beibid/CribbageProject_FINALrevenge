<Page x:Class="cribbage_Royale_PROYECTO.Views.ResetPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.ResetPassword_Title}"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <StackPanel Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.ResetPassword_Title}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Text="{x:Static lang:Lang.ResetPassword_Subtitle}"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,4" />

            <TextBlock x:Name="emailTextBlock"
                       FontSize="13"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <messages:MessagePanel x:Name="resetMessagePanel"
                                   Margin="0,0,0,12" />

            <TextBlock Text="{x:Static lang:Lang.ResetPassword_CodeLabel}"
                       Style="{StaticResource FormLabel}" />

            <TextBox x:Name="verificationCodeTextBox"
                     Style="{StaticResource FormTextBox}"
                     MaxLength="6" />

            <TextBlock Text="{x:Static lang:Lang.ResetPassword_NewPasswordLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,14,0,0" />

            <PasswordBox x:Name="newPasswordBox"
                         Style="{StaticResource FormPasswordBox}"
                         MaxLength="64" />

            <TextBlock Text="{x:Static lang:Lang.ResetPassword_ConfirmPasswordLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,14,0,0" />

            <PasswordBox x:Name="confirmPasswordBox"
                         Style="{StaticResource FormPasswordBox}"
                         MaxLength="64" />

            <Button x:Name="resetButton"
                    Content="{x:Static lang:Lang.ResetPassword_ResetButton}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,24,0,0"
                    Click="ResetButton_Click" />

            <Button x:Name="resendCodeButton"
                    Content="{x:Static lang:Lang.ResetPassword_ResendCodeButton}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,10,0,0"
                    Click="ResendCodeButton_Click" />

            <Button x:Name="cancelButton"
                    Content="{x:Static lang:Lang.ResetPassword_CancelButton}"
                    Style="{StaticResource NeutralButton}"
                    Margin="0,10,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>