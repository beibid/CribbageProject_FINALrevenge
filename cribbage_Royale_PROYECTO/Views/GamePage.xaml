<Page x:Class="cribbage_Royale_PROYECTO.Views.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="GamePage">

    <Page.Resources>
        <DataTemplate x:Key="PlayedCardTemplate">
            <Border Width="52" Height="74" Margin="0,0,8,0"
                    CornerRadius="{StaticResource PlayingCardCornerRadius}"
                    Background="{StaticResource CardFaceBrush}">
                <TextBlock x:Name="playedCardTextBlock"
                           Text="{Binding DisplayText}"
                           Foreground="{StaticResource CardBlackSuitBrush}"
                           FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRedSuit}" Value="True">
                    <Setter TargetName="playedCardTextBlock"
                            Property="Foreground"
                            Value="{StaticResource CardRedSuitBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="opponentNameTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>

                    <StackPanel x:Name="rivalOnlinePanel"
                                Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource SuccessBrush}"/>
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="11"
                                   Text="{x:Static lang:Lang.Game_RivalOnline}"/>
                    </StackPanel>

                    <StackPanel x:Name="rivalOfflinePanel"
                                Orientation="Horizontal"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource MutedTextBrush}"/>
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="{x:Static lang:Lang.Game_RivalOffline}"/>
                    </StackPanel>

                    <Border x:Name="hostBadgeBorder"
                            Background="{StaticResource PanelBrush}" CornerRadius="10"
                            Padding="8,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="{x:Static lang:Lang.Game_HostBadge}"
                                   Foreground="{StaticResource GoldBrush}" FontSize="11"/>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="opponentHandItemsControl" Grid.Column="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PlayingCardBack}">
                                <TextBlock Text="♦" Foreground="{StaticResource GoldBrush}"
                                           FontSize="30" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <messages:MessagePanel x:Name="matchMessagePanel" Grid.Row="1" Margin="0,16,0,0"/>

            <Grid Grid.Row="2" Margin="0,20">
                <Rectangle Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"
                           StrokeDashArray="6 4" RadiusX="8" RadiusY="8" Opacity="0.7"/>

                <Grid Margin="24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="cribOwnerTextBlock"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                        <Grid Width="170" Height="100" HorizontalAlignment="Left">
                            <Rectangle Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" RadiusX="6" RadiusY="6"/>

                            <TextBlock x:Name="cribEmptyTextBlock"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontSize="12" FontWeight="Bold"
                                       Text="{x:Static lang:Lang.Game_CribLabel}"/>

                            <ItemsControl x:Name="cribItemsControl"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PlayingCardBack}"
                                                Width="32" Height="46" Margin="2,0">
                                            <TextBlock Text="♦"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       FontSize="14" Opacity="0.55"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Static lang:Lang.Game_StarterCardLabel}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <ContentControl x:Name="starterCardContentControl"
                                        ContentTemplate="{StaticResource PlayingCardFaceTemplate}"
                                        Width="70" Height="100"
                                        Background="{StaticResource CardFaceBrush}">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="{StaticResource PlayingCardCornerRadius}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                        <StackPanel x:Name="discardPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static lang:Lang.Game_CribInstruction}"
                                       Foreground="{StaticResource GoldBrush}" FontSize="15"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                        </StackPanel>

                        <StackPanel x:Name="playPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14"
                                    Padding="16,6" HorizontalAlignment="Center">
                                <TextBlock x:Name="runningCountTextBlock"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontSize="14" FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="turnTextBlock"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13" FontWeight="Bold"/>

                            <TextBlock Text="{x:Static lang:Lang.Game_PlayedCardsLabel}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,14,0,6"/>

                            <ItemsControl x:Name="playedCardsItemsControl"
                                          ItemTemplate="{StaticResource PlayedCardTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static lang:Lang.Game_YouLabel}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

                <ItemsControl x:Name="playerHandItemsControl" Grid.Column="1" Margin="0,20,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource PlayingCardToggle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsPlayable}"
                                          Checked="PlayerCard_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Row="4" Margin="0,24,0,0">
                <TextBlock x:Name="timeRemainingTextBlock"
                           Foreground="{StaticResource SuccessBrush}" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="leaveMatchButton"
                            Content="{x:Static lang:Lang.Game_LeaveButton}"
                            Style="{StaticResource DangerOutlineButton}"
                            Width="180" Height="44" Margin="0,0,12,0"
                            Click="LeaveMatchButton_Click"/>
                    <Button x:Name="discardButton"
                            Content="{x:Static lang:Lang.Game_DiscardButton}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="0" Width="180" Height="44"
                            Click="DiscardButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Lang.Game_BoardTitle}"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="13" FontWeight="Bold"/>

                    <Border Background="{StaticResource TrackBrush}"
                            CornerRadius="{StaticResource InputCornerRadius}"
                            Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="goalTextBlock" Grid.Column="2"
                                           Foreground="{StaticResource GoldBrush}" FontSize="10"
                                           HorizontalAlignment="Right" Margin="0,0,0,6"/>

                                <TextBlock Text="{x:Static lang:Lang.Game_BoardOpponentRow}"
                                           Grid.Row="1"
                                           Foreground="{StaticResource CoralBrush}"
                                           FontSize="11" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>

                                <ItemsControl x:Name="opponentTrackItemsControl"
                                              Grid.Row="1" Grid.Column="1" Height="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse x:Name="holeEllipse"
                                                     Style="{StaticResource BoardHoleEllipse}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasPeg}" Value="True">
                                                    <Setter TargetName="holeEllipse" Property="Width" Value="9"/>
                                                    <Setter TargetName="holeEllipse" Property="Height" Value="9"/>
                                                    <Setter TargetName="holeEllipse" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="holeEllipse" Property="Fill"
                                                            Value="{StaticResource CoralBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{x:Static lang:Lang.Game_BoardPlayerRow}"
                                           Grid.Row="2"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontSize="11" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>

                                <ItemsControl x:Name="playerTrackItemsControl"
                                              Grid.Row="2" Grid.Column="1" Height="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse x:Name="holeEllipse"
                                                     Style="{StaticResource BoardHoleEllipse}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasPeg}" Value="True">
                                                    <Setter TargetName="holeEllipse" Property="Width" Value="9"/>
                                                    <Setter TargetName="holeEllipse" Property="Height" Value="9"/>
                                                    <Setter TargetName="holeEllipse" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="holeEllipse" Property="Fill"
                                                            Value="{StaticResource GoldBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2"
                                        Width="34" Height="34" Margin="12,0,0,0"
                                        CornerRadius="4"
                                        BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                                    <Ellipse Width="10" Height="10"
                                             Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="lastGainTextBlock"
                                       Foreground="{StaticResource GoldBrush}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="{StaticResource InputCornerRadius}"
                            Padding="12,8" Margin="0,12,0,0">
                        <TextBlock x:Name="scoreTextBlock"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="phaseTitleTextBlock"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="phaseFirstLineTextBlock"
                               Foreground="{StaticResource TextBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="phaseSecondLineTextBlock"
                               Foreground="{StaticResource TextBrush}" FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button x:Name="rulesButton"
                    Content="{x:Static lang:Lang.Game_RulesButton}"
                    Style="{StaticResource NeutralButton}"
                    Height="38" Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    Click="RulesButton_Click"/>

            <Button x:Name="matchInfoButton"
                    Content="{x:Static lang:Lang.Game_MatchInfoButton}"
                    Style="{StaticResource NeutralButton}"
                    Height="38" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</Page>