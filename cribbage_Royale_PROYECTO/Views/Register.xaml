<Page x:Class="cribbage_Royale_PROYECTO.Views.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Register">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="{x:Static lang:Lang.Register_Title}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Static lang:Lang.Register_Subtitle}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,6,0,26"/>

            <!-- Fields -->
            <TextBlock Text="{x:Static lang:Lang.Register_UsernameLabel}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="UsernameTextBox" Style="{StaticResource FormTextBox}" MaxLength="16"/>

            <TextBlock Text="{x:Static lang:Lang.Register_EmailLabel}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="EmailTextBox" Style="{StaticResource FormTextBox}" MaxLength="254"/>

            <TextBlock Text="{x:Static lang:Lang.Register_PasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <TextBlock Text="{x:Static lang:Lang.Register_ConfirmPasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <!-- Terms -->
            <CheckBox x:Name="TermsCheckBox"
                      Content="{x:Static lang:Lang.Register_TermsCheckBox}"
                      Foreground="{StaticResource TextBrush}" FontSize="12"
                      Margin="0,0,0,16"/>

            <!-- Buttons -->
            <Button x:Name="RegisterButton" Content="{x:Static lang:Lang.Register_RegisterButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,0,6"/>

            <Button x:Name="BackButton" Content="{x:Static lang:Lang.Register_BackButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>