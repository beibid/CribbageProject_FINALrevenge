<Page x:Class="cribbage_Royale_PROYECTO.Views.RecoverPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.RecoverPassword_Title}"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <StackPanel Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.RecoverPassword_Title}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Text="{x:Static lang:Lang.RecoverPassword_Subtitle}"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20" />

            <messages:MessagePanel x:Name="recoverMessagePanel"
                                   Margin="0,0,0,12" />

            <TextBlock Text="{x:Static lang:Lang.RecoverPassword_EmailLabel}"
                       Style="{StaticResource FormLabel}" />

            <TextBox x:Name="emailTextBox"
                     Style="{StaticResource FormTextBox}"
                     MaxLength="100" />

            <Button x:Name="sendCodeButton"
                    Content="{x:Static lang:Lang.RecoverPassword_SendCodeButton}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,24,0,0"
                    Click="SendCodeButton_Click" />

            <Button x:Name="cancelButton"
                    Content="{x:Static lang:Lang.RecoverPassword_CancelButton}"
                    Style="{StaticResource NeutralButton}"
                    Margin="0,10,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>