<Page x:Class="cribbage_Royale_PROYECTO.Views.FriendRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="FriendRequestsPage"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <TextBlock Text="{x:Static lang:Lang.FriendRequests_PageTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="closeButton" Content="{x:Static lang:Lang.Common_CloseButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Width="110" Height="32" FontSize="12"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <TextBlock x:Name="emptyListTextBlock"
                           Text="{x:Static lang:Lang.FriendRequests_EmptyListMessage}"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <ListBox x:Name="requestsListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8" Width="1000">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{x:Static lang:Lang.FriendRequests_AcceptButton}"
                                            Style="{StaticResource SecondaryButton}" MinWidth="0"
                                            Width="120" Height="28" FontSize="11" Margin="0,0,8,0"
                                            Visibility="{Binding ResponseVisibility}"
                                            Click="AcceptButton_Click"/>
                                    <Button Content="{x:Static lang:Lang.FriendRequests_DeclineButton}"
                                            Style="{StaticResource DangerOutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Visibility="{Binding ResponseVisibility}"
                                            Click="DeclineButton_Click"/>
                                    <Button Content="{x:Static lang:Lang.FriendRequests_CancelButton}"
                                            Style="{StaticResource DangerOutlineButton}"
                                            Width="120" Height="28" FontSize="11"
                                            Visibility="{Binding CancelVisibility}"
                                            Click="CancelRequestButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>