<Page x:Class="cribbage_Royale_PROYECTO.Views.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:cribbage_Royale_PROYECTO.Views"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Settings">

    <Grid Background="{StaticResource DarkBackgroundBrush}">

        <!-- Settings panel -->
        <Border Width="460" Padding="44,32" CornerRadius="12" BorderThickness="1.5"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <!-- Close button (top right corner) -->
                <Button x:Name="CloseButton" Content="✕" Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-16,-28,0" Click="CloseButton_Click"/>

                <StackPanel>
                    <!-- Title -->
                    <TextBlock Text="{x:Static lang:Lang.Settings_Title}"
                               Foreground="{StaticResource GoldBrush}"
                               FontFamily="Inter, Segoe UI" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Music volume -->
                    <TextBlock Text="{x:Static lang:Lang.Settings_MusicVolume}"
                               Style="{StaticResource SettingsLabel}"/>
                    <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100"
                            Value="70" Margin="0,0,0,20"/>

                    <!-- Effects volume -->
                    <TextBlock Text="{x:Static lang:Lang.Settings_EffectsVolume}"
                               Style="{StaticResource SettingsLabel}"/>
                    <Slider x:Name="EffectsVolumeSlider" Minimum="0" Maximum="100"
                            Value="80" Margin="0,0,0,20"/>

                    <!-- Language (the selected item is set from code) -->
                    <TextBlock Text="{x:Static lang:Lang.Settings_Language}"
                               Style="{StaticResource SettingsLabel}"/>
                    <ComboBox x:Name="LanguageComboBox" Style="{StaticResource DarkComboBox}"
                              Margin="0,0,0,20">
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_LanguageSpanish}" Tag="es-MX"/>
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_LanguageEnglish}" Tag="en-US"/>
                    </ComboBox>

                    <!-- Color blind mode -->
                    <TextBlock Text="{x:Static lang:Lang.Settings_ColorBlindMode}"
                               Style="{StaticResource SettingsLabel}"/>
                    <ComboBox x:Name="ColorBlindModeComboBox" Style="{StaticResource DarkComboBox}"
                              SelectedIndex="0" Margin="0,0,0,20">
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_ColorBlindOff}" Tag="DESACTIVADO"/>
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_Protanopia}" Tag="PROTANOPIA"/>
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_Deuteranopia}" Tag="DEUTERANOPIA"/>
                        <ComboBoxItem Content="{x:Static lang:Lang.Settings_Tritanopia}" Tag="TRITANOPIA"/>
                    </ComboBox>

                    <!-- Show animations -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static lang:Lang.Settings_ShowAnimations}"
                                   Style="{StaticResource SettingsLabel}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AnimationsToggle" Grid.Column="1"
                                  Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                    </Grid>

                    <!-- Friend request notifications -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static lang:Lang.Settings_FriendRequestNotifications}"
                                   Style="{StaticResource SettingsLabel}"
                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FriendRequestNotificationsToggle" Grid.Column="1"
                                  Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                    </Grid>

                    <!-- Reset / Save -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ResetButton" Content="{x:Static lang:Lang.Settings_ResetButton}"
                                Style="{StaticResource NeutralButton}"/>
                        <Button x:Name="SaveButton" Grid.Column="2"
                                Content="{x:Static lang:Lang.Settings_SaveButton}"
                                Style="{StaticResource MenuButton}" MinWidth="0"
                                MouseEnter="Button_MouseEnter" Click="SaveButton_Click"/>
                    </Grid>

                    <!-- Log out (hidden until there is an active session) -->
                    <Button x:Name="LogoutButton" Content="{x:Static lang:Lang.Settings_LogoutButton}"
                            Style="{StaticResource DangerOutlineButton}"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>