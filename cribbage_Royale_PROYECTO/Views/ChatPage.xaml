<Page x:Class="cribbage_Royale_PROYECTO.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:langs="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="titleTextBlock" Grid.Row="0" FontSize="20" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <ListBox x:Name="messagesListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding TimeText}" Width="50" Foreground="Gray" />
                            <TextBlock Text="{Binding SenderName}" FontWeight="Bold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="emptyConversationTextBlock"
                       Text="{x:Static langs:Lang.Chat_EmptyConversationText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="messageTextBox" Grid.Column="0" MaxLength="500" />

            <Button x:Name="sendButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,4"
                    Content="{x:Static langs:Lang.Chat_SendButton}"
                    Click="SendButton_Click" />
        </Grid>

        <Button x:Name="closeButton"
                Grid.Row="3"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Padding="16,4"
                Content="{x:Static langs:Lang.Chat_CloseButton}"
                Click="CloseButton_Click" />
    </Grid>
</Page>