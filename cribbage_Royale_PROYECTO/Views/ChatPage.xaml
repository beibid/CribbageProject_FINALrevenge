<Page x:Class="cribbage_Royale_PROYECTO.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:langs="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Style="{StaticResource CardPanel}"
                Margin="40,30"
                MaxWidth="900">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Button x:Name="closeButton"
        Width="40"
        Height="40"
        MinWidth="0"
        Padding="0"
        HorizontalAlignment="Left"
        Content="✕"
        FontSize="18"
        FontWeight="Bold"
        Foreground="{StaticResource TextBrush}"
        Style="{StaticResource NeutralButton}"
        ToolTip="{x:Static langs:Lang.Chat_CloseButton}"
        AutomationProperties.Name="{x:Static langs:Lang.Chat_CloseButton}"
        Click="CloseButton_Click" />

                    <TextBlock x:Name="titleTextBlock"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" />

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="{Binding Text.Length, ElementName=messageTextBox, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding MaxLength, ElementName=messageTextBox, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource TrackBrush}"
                        CornerRadius="{StaticResource InputCornerRadius}"
                        Padding="14">
                    <Grid>
                        <ListBox x:Name="messagesListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource GoldBrush}" />
                                            <TextBlock Text="{Binding TimeText}"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="emptyConversationTextBlock"
                                   Text="{x:Static langs:Lang.Chat_EmptyConversationText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Background="{StaticResource TrackBrush}"
                        CornerRadius="{StaticResource InputCornerRadius}"
                        Padding="10,6">
                    <TextBox x:Name="messageTextBox"
                             MaxLength="500"
                             Height="70"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             FontSize="14" />
                </Border>

                <Button x:Name="sendButton"
                        Grid.Row="3"
                        Margin="0,16,0,0"
                        Width="220"
                        Height="46"
                        HorizontalAlignment="Center"
                        Content="{x:Static langs:Lang.Chat_SendButton}"
                        Style="{StaticResource PrimaryButton}"
                        Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>