<Page x:Class="cribbage_Royale_PROYECTO.Views.Tutorial"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Tutorial">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_Title}"
                   Grid.ColumnSpan="2"
                   Foreground="{StaticResource GoldBrush}"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button x:Name="closeButton" Grid.Column="1"
                Content="{x:Static lang:Lang.Tutorial_CloseButton}"
                Style="{StaticResource SecondaryButton}"
                Width="100" Height="30" MinWidth="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="CloseButton_Click"/>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8" Padding="0,8">
            <StackPanel>
                <RadioButton x:Name="objectiveNavButton" GroupName="TutorialSections"
                             Content="{x:Static lang:Lang.Tutorial_ObjectiveTab}"
                             Style="{StaticResource TutorialNavButton}"
                             Checked="ObjectiveNavButton_Checked"/>

                <RadioButton x:Name="dealAndCribNavButton" GroupName="TutorialSections"
                             Content="{x:Static lang:Lang.Tutorial_DealAndCribTab}"
                             Style="{StaticResource TutorialNavButton}"
                             Checked="DealAndCribNavButton_Checked"/>

                <RadioButton x:Name="playPhaseNavButton" GroupName="TutorialSections"
                             Content="{x:Static lang:Lang.Tutorial_PlayPhaseTab}"
                             Style="{StaticResource TutorialNavButton}"
                             Checked="PlayPhaseNavButton_Checked"/>

                <RadioButton x:Name="handCountingNavButton" GroupName="TutorialSections"
                             Content="{x:Static lang:Lang.Tutorial_HandCountingTab}"
                             Style="{StaticResource TutorialNavButton}"
                             Checked="HandCountingNavButton_Checked"/>

                <RadioButton x:Name="boardNavButton" GroupName="TutorialSections"
                             Content="{x:Static lang:Lang.Tutorial_BoardTab}"
                             Style="{StaticResource TutorialNavButton}"
                             Checked="BoardNavButton_Checked"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="20,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="sectionContentControl"
                            MaxWidth="700" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</Page>