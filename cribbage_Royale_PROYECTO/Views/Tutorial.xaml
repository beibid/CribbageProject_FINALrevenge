<Page x:Class="cribbage_Royale_PROYECTO.Views.Tutorial"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Tutorial">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{x:Static lang:Lang.Tutorial_Title}"
                   Grid.ColumnSpan="2"
                   Foreground="{StaticResource GoldBrush}"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button x:Name="CloseButton" Grid.Column="1"
                Content="{x:Static lang:Lang.Tutorial_CloseButton}"
                Style="{StaticResource SecondaryButton}"
                Width="100" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="CloseButton_Click"/>

        <StackPanel Grid.Row="1">
            <Button x:Name="ObjectiveButton" Content="{x:Static lang:Lang.Tutorial_ObjectiveTab}"
                    Style="{StaticResource SecondaryButton}"
                    Width="Auto" MinWidth="0" HorizontalAlignment="Stretch"
                    Height="36" Margin="0,0,0,6" Click="ObjectiveButton_Click"/>
            <Button x:Name="DealAndCribButton" Content="{x:Static lang:Lang.Tutorial_DealAndCribTab}"
                    Style="{StaticResource SecondaryButton}"
                    Width="Auto" MinWidth="0" HorizontalAlignment="Stretch"
                    Height="36" Margin="0,0,0,6" Click="DealAndCribButton_Click"/>
            <Button x:Name="PlayPhaseButton" Content="{x:Static lang:Lang.Tutorial_PlayPhaseTab}"
                    Style="{StaticResource SecondaryButton}"
                    Width="Auto" MinWidth="0" HorizontalAlignment="Stretch"
                    Height="36" Margin="0,0,0,6" Click="PlayPhaseButton_Click"/>
            <Button x:Name="HandCountingButton" Content="{x:Static lang:Lang.Tutorial_HandCountingTab}"
                    Style="{StaticResource SecondaryButton}"
                    Width="Auto" MinWidth="0" HorizontalAlignment="Stretch"
                    Height="36" Margin="0,0,0,6" Click="HandCountingButton_Click"/>
            <Button x:Name="BoardButton" Content="{x:Static lang:Lang.Tutorial_BoardTab}"
                    Style="{StaticResource SecondaryButton}"
                    Width="Auto" MinWidth="0" HorizontalAlignment="Stretch"
                    Height="36" Click="BoardButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="20,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="SectionContent" MaxWidth="700" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</Page>