<Page x:Class="cribbage_Royale_PROYECTO.Views.ReportPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      xmlns:messages="clr-namespace:cribbage_Royale_PROYECTO.Views.Messages"
      Title="{x:Static lang:Lang.ReportPlayer_Title}"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel Width="430"
                    HorizontalAlignment="Center">
            <TextBlock Text="{x:Static lang:Lang.ReportPlayer_Title}"
                       FontSize="34"
                       Foreground="{StaticResource GoldBrush}" />
            <TextBlock x:Name="reportedUsernameTextBlock"
                       FontSize="14"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}" />
            <messages:MessagePanel x:Name="messagePanel"
                                    Margin="0,16,0,0" />
            <TextBlock Text="{x:Static lang:Lang.ReportPlayer_ReasonLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,16,0,0" />
            <ComboBox x:Name="reasonComboBox"
                      Style="{StaticResource DarkComboBox}"
                      DisplayMemberPath="DisplayText" />
            <TextBlock Text="{x:Static lang:Lang.ReportPlayer_CommentLabel}"
                       Style="{StaticResource FormLabel}"
                       Margin="0,16,0,0" />
            <TextBox x:Name="commentTextBox"
                     Style="{StaticResource FormTextBox}"
                     MinHeight="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True" />
            <Button x:Name="submitReportButton"
                    Margin="0,24,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static lang:Lang.ReportPlayer_SubmitButton}"
                    Click="SubmitReportButton_Click" />
            <Button x:Name="submitAndBlockButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource DangerOutlineButton}"
                    Content="{x:Static lang:Lang.ReportPlayer_SubmitAndBlockButton}"
                    Click="SubmitAndBlockButton_Click" />
            <Button x:Name="cancelButton"
                    Margin="0,10,0,0"
                    Style="{StaticResource NeutralButton}"
                    Content="{x:Static lang:Lang.Common_CancelButton}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>