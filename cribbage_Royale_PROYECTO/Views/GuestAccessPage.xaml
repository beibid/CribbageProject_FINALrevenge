<Page x:Class="cribbage_Royale_PROYECTO.Views.GuestAccessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="GuestAccessPage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{x:Static lang:Lang.GuestAccess_PageTitle}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Static lang:Lang.GuestAccess_HeaderText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6,0,20"/>

            <TextBlock Text="{x:Static lang:Lang.GuestAccess_NameHint}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="displayNameTextBox" Style="{StaticResource FormTextBox}" MaxLength="20"/>

            <TextBlock Text="{x:Static lang:Lang.GuestAccess_LimitationsText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <Button x:Name="continueButton" Content="{x:Static lang:Lang.GuestAccess_ContinueButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,0,6"
                    Click="ContinueButton_Click"/>

            <Button x:Name="backButton" Content="{x:Static lang:Lang.Common_BackButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>