<Page x:Class="cribbage_Royale_PROYECTO.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:cribbage_Royale_PROYECTO.Properties.Langs"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="Login">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="{x:Static lang:Lang.Login_Title}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Static lang:Lang.Login_Subtitle}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,6,0,26"/>

            <!-- Fields -->
            <TextBlock Text="{x:Static lang:Lang.Login_UsernameLabel}"
                       Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="UsernameTextBox" Style="{StaticResource FormTextBox}"/>

            <TextBlock Text="{x:Static lang:Lang.Login_PasswordLabel}"
                       Style="{StaticResource FormLabel}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBox}"/>

            <!-- Buttons -->
            <Button x:Name="SignInButton" Content="{x:Static lang:Lang.Login_SignInButton}"
        Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,10,0,6"
        Click="SignInButton_Click"/>

            <Button x:Name="CreateAccountButton" Content="{x:Static lang:Lang.Login_CreateAccountButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,0,6"
                    Click="CreateAccountButton_Click"/>

            <Button x:Name="ForgotPasswordButton" Content="{x:Static lang:Lang.Login_ForgotPasswordButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    BorderThickness="0" Foreground="{StaticResource TextBrush}"
                    Height="26" FontSize="12" FontWeight="Normal" Margin="0,0,0,6"/>

            <Button x:Name="CancelButton" Content="{x:Static lang:Lang.Login_CancelButton}"
                    Style="{StaticResource SecondaryButton}" MinWidth="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>