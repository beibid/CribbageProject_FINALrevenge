<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="cribbage_Royale_PROYECTO.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<userSettings>
		<cribbage_Royale_PROYECTO.Properties.Settings>
			<setting name="codeLanguage" serializeAs="String">
				<value>en-US</value>
			</setting>
		</cribbage_Royale_PROYECTO.Properties.Settings>
	</userSettings>
	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
	<connectionStrings configSource="ConnectionStrings.config" />
	<appSettings file="AppSettings.config">
		<add key="SmtpHost" value="smtp.gmail.com" />
		<add key="SmtpPort" value="587" />
		<add key="SmtpAddress" value="cribbageroyalegame@gmail.com" />
		<add key="SmtpSenderName" value="Cribbage Royale" />
	</appSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Serilog" publicKeyToken="24c2f752a8e58a10" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.4.0.0" newVersion="4.4.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="CribbageBinding">
					<security mode="None" />
				</binding>

				<binding name="CribbageSessionBinding" receiveTimeout="10:00:00" sendTimeout="00:00:10">
					<reliableSession enabled="true" inactivityTimeout="00:00:30" />
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>

		<client>
			<endpoint name="StatisticsEndpoint"
					  address="net.tcp://localhost:8090/CribbageRoyale/Statistics"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IStatistics" />

			<endpoint name="PlayerSessionEndpoint"
					  address="net.tcp://localhost:8091/CribbageRoyale/PlayerSession"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageSessionBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IPlayerSession" />
			<endpoint name="FriendListEndpoint"
					  address="net.tcp://localhost:8092/CribbageRoyale/FriendList"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IFriendList" />
			<endpoint name="FriendRequestsEndpoint"
					  address="net.tcp://localhost:8093/CribbageRoyale/FriendRequests"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IFriendRequests" />
			<endpoint name="FriendChatEndpoint"
					  address="net.tcp://localhost:8094/CribbageRoyale/FriendChat"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IFriendChat" />
			<endpoint name="MatchInvitationEndpoint"
					  address="net.tcp://localhost:8095/CribbageRoyale/MatchInvitation"
					  binding="netTcpBinding"
					  bindingConfiguration="CribbageBinding"
					  contract="CribbageRoyale.Contracts.ServiceContracts.IMatchInvitation" />
			<endpoint name="MatchPlayEndpoint"
		  address="net.tcp://localhost:8096/CribbageRoyale/MatchPlay"
		  binding="netTcpBinding"
		  bindingConfiguration="CribbageBinding"
		  contract="CribbageRoyale.Contracts.ServiceContracts.IMatchPlay" />
		</client>
		
	</system.serviceModel>
</configuration>